# BIND 和 PORT 是防篡改固定值：服务只接受 127.0.0.1:8787，
# 改成其他值会在启动时被拒绝（公网暴露只允许经反向代理）。
DAWNPILOT_BIND=127.0.0.1
DAWNPILOT_PORT=8787
DAWNPILOT_TOKEN=
DAWNPILOT_CACHE_TTL=900
DAWNPILOT_REFRESH_INTERVAL=1800
DAWNPILOT_UPSTREAM_TIMEOUT=15
DAWNPILOT_CACHE_FILE=/var/lib/dawnpilot/cache.json
DAWNPILOT_CACHE_MAX_ENTRIES=32
DAWNPILOT_CACHE_RETENTION=604800
DAWNPILOT_MAX_UPSTREAM_CONCURRENCY=2
DAWNPILOT_FAILURE_BACKOFF=60
DAWNPILOT_FAILURE_BACKOFF_MAX=900
